NVIDIA_API_KEY=
NIM_MODEL=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional second model for the X5 per-side comparison (seller=NIM_MODEL,
# buyer=NIM_MODEL_B). Leave empty to use NIM_MODEL on both sides.
NIM_MODEL_B=
# Optional per-deployment timeout overrides (keep LLM < BLOCKING < HTTP).
# Useful for slow free-tier hosted models; frozen v2.2 defaults stay 30/45/60.
# A2A_LLM_TIMEOUT=120
# A2A_BLOCKING_TIMEOUT=180
# A2A_HTTP_TIMEOUT=240
# A2A_POLL_MAX=300
A2A_TOKEN=
# Optional overrides (rarely needed)
# A2A_SELLER_DB=data/seller.db
# A2A_BUYER_DB=data/buyer.db
# A2A_TRACE_PATH=logs/trace.jsonl
